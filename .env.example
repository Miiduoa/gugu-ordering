# Copy to .env for a local walkthrough. Never upload .env or data/.
APP_MODE=demo
DATA_DIR=./data
PUBLIC_ORIGIN=http://127.0.0.1:8000
COOKIE_SECURE=0
ALLOWED_HOSTS=127.0.0.1,localhost
# Optional. Leave absent to generate data/.secret automatically.
# SECRET_KEY=at-least-40-random-characters-keep-private-and-back-up
